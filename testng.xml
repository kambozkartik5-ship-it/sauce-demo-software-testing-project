<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Automated Test Suite" verbose="2">

    <!-- Global Test Listeners -->
    <listeners>
        <listener class-name="com.saucedemo.utils.TestListener" />
    </listeners>

    <!-- Chrome Test Execution -->
    <test name="SauceDemo Regression Tests - Chrome">
        <parameter name="browser" value="chrome" />
        <classes>
            <class name="com.saucedemo.tests.LoginTest" />
            <class name="com.saucedemo.tests.ProductsTest" />
            <class name="com.saucedemo.tests.CartTest" />
            <class name="com.saucedemo.tests.CheckoutTest" />
        </classes>
    </test>

</suite>
